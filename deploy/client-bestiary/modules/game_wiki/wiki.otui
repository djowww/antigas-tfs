BestiaryFilter < Button
  size: 86 20
  color: #BDBDBD

  $on:
    image-clip: 0 46 22 23
    color: #D2C49D

BestiaryStage < UIWidget
  size: 4 4
  border: 1 #696353
  background-color: #262626
  phantom: true

MonsterObject < UIWidget
  background-color: #343434
  border: 1 #555555
  focusable: true
  @onClick: modules.game_wiki.selectCreature(self.creatureId)

  Label
    id: creatureLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    margin-left: 14
    margin-right: 14
    height: 28
    text-wrap: false
    text-align: center
    color: #D1D1D1
    font: verdana-11px-rounded
    phantom: true

  Panel
    id: spriteArea
    size: 64 64
    anchors.top: creatureLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    background-color: alpha

    UICreature
      id: creature
      size: 32 32
      anchors.centerIn: parent
      old-scaling: true
      outfit-center: true
      animate: false
      phantom: true

  Panel
    id: killProgressTrack
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: spriteArea.bottom
    margin-top: 2
    margin-left: 9
    margin-right: 9
    height: 8
    background-color: #202020
    border: 1 #171717

    UIProgressBar
      id: killProgressBar
      anchors.fill: parent
      margin: 1
      background-color: #958358
      phantom: true

  Label
    id: killProgressText
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: killProgressTrack.bottom
    margin-top: 2
    height: 13
    text-align: center
    color: #BCB8AA
    font: verdana-11px-rounded
    phantom: true

  BestiaryStage
    id: stage2
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: killProgressText.bottom
    margin-top: 3

  BestiaryStage
    id: stage1
    anchors.right: stage2.left
    anchors.top: stage2.top
    margin-right: 5

  BestiaryStage
    id: stage3
    anchors.left: stage2.right
    anchors.top: stage2.top
    margin-left: 5

  UIWidget
    id: rewardBadgeSlot
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 3
    size: 10 10
    visible: false
    phantom: true

MainWindow
  id: wikiWindow
  visible: false
  !text: tr('Bestiary')
  size: 700 450
  @onEscape: modules.game_wiki.hide()

  BestiaryFilter
    id: filter_all
    anchors.top: parent.top
    anchors.left: parent.left
    text: All
    tooltip: Show every monster, including those not yet hunted.
    on: true
    @onClick: modules.game_wiki.setProgressFilter('all')

  BestiaryFilter
    id: filter_progress
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 4
    text: In Progress
    tooltip: Monsters with 1 to 999 kills.
    @onClick: modules.game_wiki.setProgressFilter('progress')

  BestiaryFilter
    id: filter_completed
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 4
    text: Completed
    tooltip: Monsters with 1000 kills. Rewards are not available yet.
    @onClick: modules.game_wiki.setProgressFilter('completed')

  Label
    id: resultCount
    anchors.right: parent.right
    anchors.verticalCenter: filter_all.verticalCenter
    width: 70
    text-align: right
    color: #A9A9A9
    tooltip: Visible monsters / all monsters

  Panel
    id: listPanel
    anchors.top: filter_all.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: creatureFilter.top
    margin-top: 7
    margin-bottom: 9

    ScrollablePanel
      id: list
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: listScrollbar.left
      anchors.bottom: parent.bottom
      margin-right: 5
      vertical-scrollbar: listScrollbar
      layout:
        type: grid
        align-center: false
        cell-size: 160 132
        cell-spacing: 4
        num-columns: 4

    VerticalScrollBar
      id: listScrollbar
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      pixels-scroll: true
      step: 40

    Label
      id: emptyState
      anchors.fill: list
      text: No monsters match these filters.
      text-align: center
      text-wrap: true
      color: #AAAAAA
      visible: false
      phantom: true

  Label
    id: searchLabel
    anchors.bottom: parent.bottom
    margin-bottom: 2
    anchors.left: parent.left
    width: 42
    text: Search

  TextEdit
    id: creatureFilter
    anchors.left: searchLabel.right
    anchors.right: clearFilterButton.left
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-right: 4
    placeholder: Search monster...

  Button
    id: clearFilterButton
    text: x
    tooltip: Clear search
    @onClick: modules.game_wiki.clearFilter()
    anchors.right: buttonCancel.left
    anchors.bottom: parent.bottom
    margin-right: 12
    size: 20 20

  Button
    id: buttonCancel
    !text: tr('Close')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_wiki.hide()
