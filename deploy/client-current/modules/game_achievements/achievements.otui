AchievementEntry < Panel
  height: 74
  background-color: #28292799

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 6 8 0 8
    height: 14
    color: #DDD8C6
    text-align: left

  Label
    id: reward
    anchors.top: title.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 4
    height: 14
    color: #BCA473
    text-align: left

  Label
    id: progress
    anchors.top: reward.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 4
    height: 14
    color: #C3C3BC
    text-align: left

  UIProgressBar
    id: bar
    anchors.top: progress.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 5
    height: 5
    background-color: #8E805E
    border: 1 #1c1d1b
    background-border: 1

  UIWidget
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #ffffff16
    phantom: true

MainWindow
  id: achievementWindow
  text: Achievements
  size: 660 580
  @onEscape: modules.game_achievements.hide()

  FlatPanel
    id: rankBanner
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 108
    padding: 12
    padding-top: 8
    padding-bottom: 7
    image-color: #b8b6a8
    background-color: #282a27bb

    Label
      id: rankName
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: rankStars.left
      margin-right: 12
      height: 18
      color: #DDD8C6
      text: Achievement Ranks
      text-align: left

    Panel
      id: rankStars
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 2
      size: 76 12
      layout:
        type: horizontalBox
        spacing: 4
        fit-children: false

      UIWidget
        id: star1
        size: 12 12
        phantom: true
        focusable: false

      UIWidget
        id: star2
        size: 12 12
        phantom: true
        focusable: false

      UIWidget
        id: star3
        size: 12 12
        phantom: true
        focusable: false

      UIWidget
        id: star4
        size: 12 12
        phantom: true
        focusable: false

      UIWidget
        id: star5
        size: 12 12
        phantom: true
        focusable: false

    Label
      id: rankProgress
      anchors.top: rankName.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      height: 16
      color: #AAA99E
      text: Complete achievements to advance your rank.
      text-align: left

    Panel
      id: rankTrack
      anchors.top: rankProgress.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      height: 6
      background-color: #20221f
      border: 1 #181a17

      UIProgressBar
        id: rankBar
        anchors.fill: parent
        margin: 1
        background-color: #BCA473
        phantom: true

    Panel
      id: rankMilestones
      anchors.top: rankTrack.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 9
      height: 31
      layout:
        type: horizontalBox
        spacing: 6
        fit-children: false

      Label
        id: rank1
        size: 95 31
        text-align: center
        color: #AAA99E

      Label
        id: rank2
        size: 95 31
        text-align: center
        color: #AAA99E

      Label
        id: rank3
        size: 95 31
        text-align: center
        color: #AAA99E

      Label
        id: rank4
        size: 95 31
        text-align: center
        color: #AAA99E

      Label
        id: rank5
        size: 95 31
        text-align: center
        color: #AAA99E

      Label
        id: rank6
        size: 95 31
        text-align: center
        color: #AAA99E

  ComboBox
    id: filter
    anchors.top: rankBanner.bottom
    anchors.left: parent.left
    margin-top: 10
    width: 148
    height: 22

  ComboBox
    id: category
    anchors.top: filter.top
    anchors.left: filter.right
    margin-left: 6
    width: 208
    height: 22

  Button
    id: refreshButton
    anchors.top: filter.top
    anchors.right: parent.right
    width: 76
    height: 22
    text: Refresh
    @onClick: modules.game_achievements.refresh()

  Button
    id: claimButton
    anchors.top: filter.top
    anchors.right: refreshButton.left
    margin-right: 6
    width: 114
    height: 22
    text: Claim rewards
    enabled: false
    tooltip: Receive earned item rewards after making room in your inventory.
    @onClick: modules.game_achievements.claimRewards()

  Label
    id: summary
    anchors.top: filter.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    height: 16
    color: #DDD8C6
    text: Achievement objectives
    text-align: left

  Label
    id: bonuses
    anchors.top: summary.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 16
    color: #AAA99E
    text: Progress and rewards are saved per character.
    text-align: left

  Label
    id: objectiveHeading
    anchors.top: bonuses.bottom
    anchors.left: parent.left
    margin-top: 8
    size: 88 14
    color: #DDD8C6
    text: Objectives

  HorizontalSeparator
    anchors.verticalCenter: objectiveHeading.verticalCenter
    anchors.left: objectiveHeading.right
    anchors.right: parent.right
    margin-left: 6

  ScrollablePanel
    id: entries
    anchors.top: objectiveHeading.bottom
    anchors.left: parent.left
    anchors.right: entriesScroll.left
    anchors.bottom: message.top
    margin-top: 6
    margin-right: 3
    margin-bottom: 8
    padding: 0
    vertical-scrollbar: entriesScroll
    layout:
      type: verticalBox
      spacing: 4
      fit-children: false

  VerticalScrollBar
    id: entriesScroll
    anchors.top: objectiveHeading.bottom
    anchors.right: parent.right
    anchors.bottom: message.top
    margin-top: 6
    margin-bottom: 8
    step: 78
    pixels-scroll: true

  Label
    id: message
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26
    color: #AAA99E
    text-wrap: true
    text-align: left
    text: Connect to the game to view your achievement progress.
