AchievementEntry < Panel
  height: 74
  background-color: #28292799

  Label
    id: title
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 6 8 0 8
    height: 14
    color: #DDD8C6
    text-align: left

  Label
    id: reward
    anchors.top: title.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 4
    height: 14
    color: #BCA473
    text-align: left

  Label
    id: progress
    anchors.top: reward.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 4
    height: 14
    color: #C3C3BC
    text-align: left

  UIProgressBar
    id: bar
    anchors.top: progress.bottom
    anchors.left: title.left
    anchors.right: title.right
    margin-top: 5
    height: 5
    background-color: #8E805E
    border: 1 #1c1d1b
    background-border: 1

  UIWidget
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #ffffff16
    phantom: true

MainWindow
  id: achievementWindow
  text: Achievements
  size: 660 500
  @onEscape: modules.game_achievements.hide()

  ComboBox
    id: filter
    anchors.top: parent.top
    anchors.left: parent.left
    width: 148
    height: 22

  ComboBox
    id: category
    anchors.top: parent.top
    anchors.left: filter.right
    margin-left: 6
    width: 208
    height: 22

  Button
    id: refreshButton
    anchors.top: parent.top
    anchors.right: parent.right
    width: 76
    height: 22
    text: Refresh
    @onClick: modules.game_achievements.refresh()

  Button
    id: claimButton
    anchors.top: parent.top
    anchors.right: refreshButton.left
    margin-right: 6
    width: 114
    height: 22
    text: Claim rewards
    enabled: false
    tooltip: Receive earned item rewards after making room in your inventory.
    @onClick: modules.game_achievements.claimRewards()

  Label
    id: summary
    anchors.top: filter.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    height: 16
    color: #DDD8C6
    text: Achievement objectives
    text-align: left

  Label
    id: bonuses
    anchors.top: summary.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 16
    color: #AAA99E
    text: Progress and rewards are saved per character.
    text-align: left

  ScrollablePanel
    id: entries
    anchors.top: bonuses.bottom
    anchors.left: parent.left
    anchors.right: entriesScroll.left
    anchors.bottom: message.top
    margin-top: 10
    margin-right: 3
    margin-bottom: 8
    padding: 0
    vertical-scrollbar: entriesScroll
    layout:
      type: verticalBox
      spacing: 4
      fit-children: false

  VerticalScrollBar
    id: entriesScroll
    anchors.top: bonuses.bottom
    anchors.right: parent.right
    anchors.bottom: message.top
    margin-top: 10
    margin-bottom: 8
    step: 78
    pixels-scroll: true

  Label
    id: message
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26
    color: #AAA99E
    text-wrap: true
    text-align: left
    text: Connect to the game to view your achievement progress.
