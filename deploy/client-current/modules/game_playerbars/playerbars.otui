AntigasSidebarToggle < ButtonBox
  height: 22
  width: 22
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  image-color: #ffffffbb
  icon-color: #e8dfd0
  icon-size: 12 12
  text-offset: 0 0
  border-width: 1
  border-top-color: #8b7b62
  border-left-color: #8b7b62
  border-right-color: #30271c
  border-bottom-color: #30271c
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 23 22 23
    image-color: #ffffff
    icon-color: #ffffff
    border-top-color: #d1b475
    border-left-color: #d1b475
    border-right-color: #5b4326
    border-bottom-color: #5b4326

  $checked:
    image-clip: 0 0 22 23
    text-offset: 0 0
    icon-color: #ffe0a0
    image-color: #e0ad55
    border-width: 1
    border-top-color: #f4d27f
    border-left-color: #f4d27f
    border-right-color: #8e622c
    border-bottom-color: #8e622c

  $checked hover:
    image-clip: 0 23 22 23
    icon-color: #fff5de
    image-color: #f2cf82
    border-top-color: #fff0b4
    border-left-color: #fff0b4

  $pressed:
    image-clip: 0 46 22 23
    image-color: #b58c4b
    border-top-color: #30271c
    border-left-color: #30271c
    border-right-color: #9a7841
    border-bottom-color: #9a7841

  $disabled:
    image-color: #ffffff33
    icon-color: #817b71
    color: #999187
    change-cursor-image: false

AntigasSidebarAction < Button
  height: 22
  width: 22
  padding: 0
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  image-color: #ffffffbb
  color: #ded2bd
  icon-color: #e8dfd0
  icon-size: 12 12
  text-align: center
  text-offset: 0 0
  border-width: 1
  border-top-color: #8b7b62
  border-left-color: #8b7b62
  border-right-color: #30271c
  border-bottom-color: #30271c
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 23 22 23
    image-color: #ffffff
    color: #ffffff
    icon-color: #ffffff
    border-top-color: #d1b475
    border-left-color: #d1b475
    border-right-color: #5b4326
    border-bottom-color: #5b4326

  $on:
    image-clip: 0 0 22 23
    image-color: #e0ad55
    icon-color: #ffe0a0
    border-top-color: #f4d27f
    border-left-color: #f4d27f
    border-right-color: #8e622c
    border-bottom-color: #8e622c

  $on hover:
    image-clip: 0 23 22 23
    image-color: #f2cf82
    icon-color: #fff5de
    border-top-color: #fff0b4
    border-left-color: #fff0b4

  $pressed:
    image-clip: 0 46 22 23
    image-color: #b58c4b
    text-offset: 1 1
    border-top-color: #30271c
    border-left-color: #30271c
    border-right-color: #9a7841
    border-bottom-color: #9a7841

  $disabled:
    image-color: #ffffff33
    color: #8b857b
    icon-color: #817b71
    change-cursor-image: false

AntigasSidebarAchievementAction < AntigasSidebarAction
  icon-color: #dddddd

  $hover !disabled:
    icon-color: #ffffff

  $on:
    icon-color: #ffe0a0

  $on hover:
    icon-color: #fff5de

  $disabled:
    icon-color: #817b71

SpecialMiniWindow
  id: playerBarsWindow
  height: 30
  image-border-top: 4
  text:
  @onClose: modules.game_playerbars.onMiniWindowClose()
  @onGeometryChange: modules.game_playerbars.resizeButtons()
  &save: true
  &minimizedHeight: 18
  @onMinimize: modules.game_playerbars.updateMenuToggle()
  @onMaximize: modules.game_playerbars.updateMenuToggle()

  UIButton
    id: menuToggle
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 7
    margin-right: 12
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 14 14
    change-cursor-image: true
    cursor: pointer
    tooltip: Minimizar menu
    @onClick: modules.game_playerbars.toggleMenu()

    $hover:
      image-clip: 0 14 14 14

    $pressed:
      image-clip: 0 28 14 14

    $on:
      image-clip: 14 0 14 14

    $on hover:
      image-clip: 14 14 14 14

    $on pressed:
      image-clip: 14 28 14 14

    $disabled:
      image-color: #ffffff55

    UIWidget
      id: menuUnreadIndicator
      anchors.top: parent.top
      anchors.right: parent.right
      size: 3 3
      background-color: #ffd36a
      phantom: true
      visible: false

  MiniWindowContents
    anchors.right: parent.right
    margin-left: 0
    margin-right: 0
    margin-top: 4
    margin-bottom: 4

    AntigasSidebarToggle
      id: SkillsButton
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 0
      icon-source: /images/topbuttons/skills
      tooltip: Habilidades.
      @onCheckChange: modules.game_playerbars.togglePanel('skills')

    AntigasSidebarToggle
      id: BattleButton
      anchors.left: SkillsButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/topbuttons/battle
      tooltip: Lista de batalha (Ctrl+B).
      @onCheckChange: modules.game_playerbars.togglePanel('battle')

    AntigasSidebarToggle
      id: VipButton
      anchors.left: BattleButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/topbuttons/viplist
      tooltip: Lista VIP (Ctrl+P).
      @onCheckChange: modules.game_playerbars.togglePanel('vip')

    AntigasSidebarToggle
      id: huntButton
      anchors.left: VipButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/topbuttons/huntinganalyzer
      tooltip: Estatísticas de caça e loot.
      @onCheckChange: modules.game_playerbars.togglePanel('hunt')

    AntigasSidebarAction
      id: marketButton
      anchors.left: huntButton.right
      anchors.top: huntButton.top
      tooltip: Mercado.
      @onClick: modules.game_market_antigas.toggle()

      UIWidget
        id: marketIcon
        anchors.centerIn: parent
        margin-top: -1
        size: 12 12
        image-source: /images/game/slots/coins
        image-color: #e6e6e6
        phantom: true

    AntigasSidebarAction
      id: questButton
      anchors.left: marketButton.right
      anchors.top: huntButton.top
      icon-source: /images/topbuttons/questlog
      tooltip: Diário de missões (Ctrl+J).
      @onClick: modules.game_questlog.toggle()

    AntigasSidebarAchievementAction
      id: achievementsButton
      anchors.left: questButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/game/viplist/icons
      icon-clip: 60 0 12 12
      tooltip: Conquistas.
      @onClick: modules.game_achievements.toggle()

      UIWidget
        id: achievementsUnreadIndicator
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 2
        margin-right: 2
        size: 3 3
        background-color: #ffd36a
        phantom: true
        visible: false

  UIWidget
    id: menuSeparator
    anchors.verticalCenter: menuToggle.verticalCenter
    anchors.right: menuToggle.left
    margin-right: 4
    size: 1 12
    background-color: #78664a
    phantom: true
