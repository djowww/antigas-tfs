AntigasSidebarToggle < ButtonBox
  height: 20
  width: 41
  color: #c6c6c6
  text-offset: 0 0
  border-width: 0

  $checked:
    text-offset: 0 0
    color: #e0e0e0
    border-width: 1
    border-top-color: #242424
    border-left-color: #242424
    border-right-color: #909090
    border-bottom-color: #909090

  $checked hover:
    image-clip: 0 46 22 23
    border-right-color: #b0b0b0
    border-bottom-color: #b0b0b0

  $pressed:
    text-offset: 1 1

SpecialMiniWindow

  id: playerBarsWindow
  height: 94
  text: Menu
  text-offset: 6 2
  @onClose: modules.game_playerbars.onMiniWindowClose()
  @onGeometryChange: modules.game_playerbars.resizeButtons()
  &save: true

  UIButton
    id: minimizeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 4
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 14 14
    tooltip: Minimize menu

    $hover:
      image-clip: 0 14 14 14

    $pressed:
      image-clip: 0 28 14 14

    $on:
      image-clip: 14 0 14 14
      tooltip: Expand menu

    $on hover:
      image-clip: 14 14 14 14

    $on pressed:
      image-clip: 14 28 14 14

  MiniWindowContents
    anchors.right: parent.right
    margin-left: 0
    margin-right: 0
    margin-top: 20
    margin-bottom: 0

    AntigasSidebarToggle
      id: SkillsButton
      text: Skills
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 5
      tooltip: Show or hide your character skills.
      @onCheckChange: modules.game_playerbars.togglePanel('skills')

    AntigasSidebarToggle
      id: BattleButton
      anchors.left: SkillsButton.right
      anchors.top: SkillsButton.top
      text: Battle
      tooltip: Show or hide the battle list (Ctrl+B).
      @onCheckChange: modules.game_playerbars.togglePanel('battle')

    AntigasSidebarToggle
      id: VipButton
      anchors.left: BattleButton.right
      anchors.top: BattleButton.top
      text: VIP
      tooltip: Show or hide your VIP list (Ctrl+P).
      @onCheckChange: modules.game_playerbars.togglePanel('vip')

    AntigasSidebarToggle
      id: huntButton
      anchors.left: VipButton.right
      anchors.top: VipButton.top
      text: Hunt
      tooltip: Hunt session: experience, collected loot and consumed supplies.
      @onCheckChange: modules.game_playerbars.togglePanel('hunt')

    Button
      id: marketButton
      anchors.left: SkillsButton.left
      anchors.right: BattleButton.right
      anchors.top: SkillsButton.bottom
      height: 20
      padding: 0
      text: Market
      text-align: center
      color: #c6c6c6
      tooltip: Open the Market catalog or bring it to the front.
      @onClick: modules.game_market_antigas.toggle()

    Button
      id: questButton
      anchors.left: VipButton.left
      anchors.right: huntButton.right
      anchors.top: marketButton.top
      height: 20
      padding: 0
      text: Quests
      text-align: center
      color: #c6c6c6
      tooltip: Quest Log: missions and recorded progress (Ctrl+J).
      @onClick: modules.game_questlog.toggle()

    Button
      id: achievementsButton
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: marketButton.bottom
      height: 20
      padding: 0
      text: Achievements
      text-align: center
      color: #c6c6c6
      tooltip: View your completed and upcoming achievements.
      @onClick: modules.game_achievements.toggle()
