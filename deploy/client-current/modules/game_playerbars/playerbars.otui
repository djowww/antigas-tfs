AntigasSidebarToggle < ButtonBox
  height: 22
  width: 22
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  image-color: #ffffffdd
  icon-color: #ebe7de
  icon-size: 12 12
  text-offset: 0 0
  border-width: 1
  border-top-color: #77756e
  border-left-color: #77756e
  border-right-color: #2c2b28
  border-bottom-color: #2c2b28
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 23 22 23
    image-color: #ffffff
    icon-color: #f6f3ec
    border-top-color: #aaa69a
    border-left-color: #aaa69a
    border-right-color: #4d4941
    border-bottom-color: #4d4941

  $checked:
    image-clip: 0 0 22 23
    text-offset: 0 0
    icon-color: #f2e5c9
    image-color: #d0b783
    border-width: 1
    border-top-color: #d8b46c
    border-left-color: #d8b46c
    border-right-color: #806136
    border-bottom-color: #806136

  $checked hover !disabled:
    image-clip: 0 23 22 23
    icon-color: #fff1d8
    image-color: #e0c28c
    border-top-color: #e8c67e
    border-left-color: #e8c67e
    border-right-color: #92713f
    border-bottom-color: #92713f

  $pressed !disabled:
    image-clip: 0 46 22 23
    text-offset: 0 0
    image-color: #c9c5bc
    icon-color: #ddd8cf
    border-top-color: #34322e
    border-left-color: #34322e
    border-right-color: #858075
    border-bottom-color: #858075

  $checked pressed !disabled:
    image-clip: 0 46 22 23
    text-offset: 0 0
    image-color: #b79c68
    icon-color: #e8d9ba
    border-top-color: #5b4729
    border-left-color: #5b4729
    border-right-color: #c6a15b
    border-bottom-color: #c6a15b

  $disabled:
    image-clip: 0 0 22 23
    text-offset: 0 0
    image-color: #ffffff66
    icon-color: #aaa69c
    color: #aaa69c
    border-top-color: #4d4a44
    border-left-color: #4d4a44
    border-right-color: #282622
    border-bottom-color: #282622
    change-cursor-image: false

AntigasSidebarAction < Button
  height: 22
  width: 22
  padding: 0
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  image-color: #ffffffdd
  color: #ebe7de
  icon-color: #ebe7de
  icon-size: 12 12
  text-align: center
  text-offset: 0 0
  border-width: 1
  border-top-color: #77756e
  border-left-color: #77756e
  border-right-color: #2c2b28
  border-bottom-color: #2c2b28
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    image-clip: 0 23 22 23
    image-color: #ffffff
    color: #f6f3ec
    icon-color: #f6f3ec
    border-top-color: #aaa69a
    border-left-color: #aaa69a
    border-right-color: #4d4941
    border-bottom-color: #4d4941

  $on !disabled:
    image-clip: 0 0 22 23
    image-color: #d0b783
    icon-color: #f2e5c9
    border-top-color: #d8b46c
    border-left-color: #d8b46c
    border-right-color: #806136
    border-bottom-color: #806136

  $on hover !disabled:
    image-clip: 0 23 22 23
    image-color: #e0c28c
    icon-color: #fff1d8
    border-top-color: #e8c67e
    border-left-color: #e8c67e
    border-right-color: #92713f
    border-bottom-color: #92713f

  $pressed !disabled:
    image-clip: 0 46 22 23
    image-color: #c9c5bc
    icon-color: #ddd8cf
    text-offset: 0 0
    border-top-color: #34322e
    border-left-color: #34322e
    border-right-color: #858075
    border-bottom-color: #858075

  $on pressed !disabled:
    image-clip: 0 46 22 23
    text-offset: 0 0
    image-color: #b79c68
    icon-color: #e8d9ba
    border-top-color: #5b4729
    border-left-color: #5b4729
    border-right-color: #c6a15b
    border-bottom-color: #c6a15b

  $disabled:
    image-clip: 0 0 22 23
    text-offset: 0 0
    image-color: #ffffff66
    color: #aaa69c
    icon-color: #aaa69c
    border-top-color: #4d4a44
    border-left-color: #4d4a44
    border-right-color: #282622
    border-bottom-color: #282622
    change-cursor-image: false

AntigasSidebarAchievementAction < AntigasSidebarAction
  icon-color: #d2cec6

  $hover !disabled:
    icon-color: #ebe6da

  $on !disabled:
    icon-color: #f2e5c9

  $on hover !disabled:
    icon-color: #fff1d8

  $pressed !disabled:
    icon-color: #c8c3b8

  $on pressed !disabled:
    icon-color: #e8d9ba

  $disabled:
    icon-color: #aaa69c

SpecialMiniWindow
  id: playerBarsWindow
  height: 30
  image-border-top: 4
  text:
  @onClose: modules.game_playerbars.onMiniWindowClose()
  @onGeometryChange: modules.game_playerbars.resizeButtons()
  &save: true
  &minimizedHeight: 18
  @onMinimize: modules.game_playerbars.updateMenuToggle()
  @onMaximize: modules.game_playerbars.updateMenuToggle()

  UIButton
    id: menuToggle
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 7
    margin-right: 12
    size: 14 14
    image-source: /images/ui/miniwindow_buttons
    image-clip: 0 0 14 14
    change-cursor-image: true
    cursor: pointer
    tooltip: Minimizar menu
    @onClick: modules.game_playerbars.toggleMenu()

    $hover:
      image-clip: 0 14 14 14

    $pressed:
      image-clip: 0 28 14 14

    $on:
      image-clip: 14 0 14 14

    $on hover:
      image-clip: 14 14 14 14

    $on pressed:
      image-clip: 14 28 14 14

    $disabled:
      image-color: #ffffff55

    UIWidget
      id: menuUnreadIndicator
      anchors.top: parent.top
      anchors.right: parent.right
      size: 3 3
      background-color: #ffd36a
      phantom: true
      visible: false

  MiniWindowContents
    anchors.right: parent.right
    margin-left: 0
    margin-right: 0
    margin-top: 4
    margin-bottom: 4

    AntigasSidebarToggle
      id: SkillsButton
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 0
      icon-source: /images/topbuttons/skills
      tooltip: Habilidades.
      @onCheckChange: modules.game_playerbars.togglePanel('skills')

    AntigasSidebarToggle
      id: BattleButton
      anchors.left: SkillsButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/topbuttons/battle
      tooltip: Lista de batalha (Ctrl+B).
      @onCheckChange: modules.game_playerbars.togglePanel('battle')

    AntigasSidebarToggle
      id: VipButton
      anchors.left: BattleButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/topbuttons/viplist
      tooltip: Lista VIP (Ctrl+P).
      @onCheckChange: modules.game_playerbars.togglePanel('vip')

    AntigasSidebarToggle
      id: huntButton
      anchors.left: VipButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/topbuttons/huntinganalyzer
      tooltip: Estatísticas de caça e loot.
      @onCheckChange: modules.game_playerbars.togglePanel('hunt')

    AntigasSidebarAction
      id: marketButton
      anchors.left: huntButton.right
      anchors.top: huntButton.top
      tooltip: Mercado.
      @onClick: modules.game_market_antigas.toggle()

      UIWidget
        id: marketIcon
        anchors.centerIn: parent
        margin-top: -1
        size: 12 12
        image-source: /images/game/slots/coins
        image-color: #dedad0
        phantom: true

    AntigasSidebarAction
      id: questButton
      anchors.left: marketButton.right
      anchors.top: huntButton.top
      icon-source: /images/topbuttons/questlog
      tooltip: Diário de missões (Ctrl+J).
      @onClick: modules.game_questlog.toggle()

    AntigasSidebarAchievementAction
      id: achievementsButton
      anchors.left: questButton.right
      anchors.top: SkillsButton.top
      icon-source: /images/game/viplist/icons
      icon-clip: 60 0 12 12
      tooltip: Conquistas.
      @onClick: modules.game_achievements.toggle()

      UIWidget
        id: achievementsUnreadIndicator
        anchors.top: parent.top
        anchors.right: parent.right
        margin-top: 2
        margin-right: 2
        size: 3 3
        background-color: #ffd36a
        phantom: true
        visible: false

  UIWidget
    id: menuSeparator
    anchors.verticalCenter: menuToggle.verticalCenter
    anchors.right: menuToggle.left
    margin-right: 4
    size: 1 12
    background-color: #6d685f
    phantom: true
