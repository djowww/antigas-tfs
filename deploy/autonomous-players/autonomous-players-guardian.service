[Unit]
Description=Independent read-only population health guardian
After=network-online.target

[Service]
Type=simple
User=antigas-health
Group=antigas-players
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/autonomous-players
ExecStart=/usr/bin/python3 -m tools.autonomous_players guardian --config /etc/autonomous-players/guardian.json
Restart=on-failure
RestartSec=10
Nice=15
CPUQuota=5%
MemoryMax=64M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/autonomous-health
UMask=0027

[Install]
WantedBy=multi-user.target
